{
  "manifest_version": 3,
  "name": "初见 · 新标签页",
  "version": "1.5.0",
  "description": "初见 Firstlight：本地优先的新标签页，分组网站图标、搜索、壁纸、待办与稍后读。数据只存在本机。",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "初见 · 收藏当前网页",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "history",
    "alarms",
    "favicon",
    "permissions",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://bing.biturl.top/*",
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*",
    "https://wttr.in/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://*.baidu.com/*",
    "https://api.frankfurter.dev/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  }
}
